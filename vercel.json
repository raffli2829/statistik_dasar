{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "env": {
    "PHP_VERSION": "8.5",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync",
    "LOG_CHANNEL": "stderr",
    "LARAVEL_STORAGE_PATH": "/tmp/storage"
  },
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}